{
  "name": "skylight-ballroom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:cpanel": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && (npm run build:next || (echo \"\u21bb next build failed, retrying once (known dynamic-route race)\" && node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run build:next)) && node scripts/build-cpanel.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "icons": "node scripts/gen-icons.mjs",
    "test": "tsx scripts/test-accounting.ts",
    "build:next": "next build"
  },
  "dependencies": {
    "@react-three/drei": "10.0.1",
    "@react-three/fiber": "9.0.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.474.0",
    "mysql2": "3.12.0",
    "next": "^15.5.4",
    "next-auth": "4.24.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0",
    "three": "0.172.0",
    "web-push": "^3.6.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "0.172.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
